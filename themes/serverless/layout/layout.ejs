<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="renderer" content="webkit">

  <!-- SEO Meta -->
  <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <meta name="keywords" content="<%= (page.tags ? page.tags.toArray().map(t=>t.name).join(',') : '') || config.keywords %>">
  <meta name="author" content="<%= config.author %>">

  <!-- Open Graph -->
  <meta property="og:title"       content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= page.description || config.description %>">
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="<%= config.title %>">

  <!-- Canonical -->
  <link rel="canonical" href="<%= config.url + url_for(page.path) %>">

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- Material Web Components -->
  <script type="importmap">
    {
      "imports": {
        "@material/web/": "https://esm.run/@material/web/"
      }
    }
  </script>
  <script type="module">
      import '@material/web/all.js';
  </script>

  <!-- M3 Style -->
  <link rel="stylesheet" href="/css/m3-glassmorphism.css">
</head>

<body>

  <div class="app-layout">
    
    <!-- Sidebar Overlay for mobile -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- Glassmorphism Sidebar -->
    <aside class="glass-sidebar" id="nav-drawer">
      <div class="sidebar-header">
        <span class="sidebar-title"><%= config.title %></span>
        <md-icon-button class="sidebar-close-btn hidden-desktop" onclick="toggleSidebar()" style="display:none;">
          <md-icon>close</md-icon>
        </md-icon-button>
      </div>

      <nav class="sidebar-nav">
        <a href="/" class="sidebar-link <%= page.path === '' || page.path === 'index.html' ? 'active' : '' %>">
          <span class="native-icon">home</span>主页
        </a>
        <a href="/archives/" class="sidebar-link <%= page.layout === 'archive' ? 'active' : '' %>">
          <span class="native-icon">library_books</span>文章归档
        </a>
        <a href="/tags/" class="sidebar-link <%= page.layout === 'tag' ? 'active' : '' %>">
          <span class="native-icon">label</span>标签云
        </a>
        <a href="/forum/" class="sidebar-link <%= page.path === 'forum/index.html' ? 'active' : '' %>">
          <span class="native-icon">forum</span>TG 讨论区
        </a>
        <a href="/atom.xml" class="sidebar-link" target="_blank">
          <span class="native-icon">rss_feed</span>RSS 订阅
        </a>
      </nav>

      <div style="flex:1;"></div>

      <div class="sidebar-footer">
        <a href="https://t.me/<%= config.telegram_channel || 'your_channel' %>" class="sidebar-link" target="_blank" style="margin-bottom:8px;">
          <span class="native-icon">send</span>Telegram 频道
        </a>
        <a href="/admin/" class="sidebar-link">
          <span class="native-icon">admin_panel_settings</span>管理后台
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Top Sticky Area (Navbar) -->
      <div class="top-sticky-area">
        <header>
          <div class="header-title-group">
            <md-icon-button class="hamburger-btn" onclick="toggleSidebar()" style="margin-right:8px;">
              <md-icon>menu</md-icon>
            </md-icon-button>
            <h1 class="mobile-only-title"><a href="/"><%= config.title %></a></h1>
            <div class="header-pill hidden-mobile">
              <span class="native-icon" style="font-size:14px;">bolt</span>
              <span style="font-size:12px;opacity:0.8;">Edge Computing</span>
            </div>
          </div>
          
          <div class="header-actions">
            <md-icon-button id="theme-toggle-btn">
              <md-icon>dark_mode</md-icon>
            </md-icon-button>
          </div>
        </header>
      </div>

      <div class="container">
        <%- body %>
      </div>

      <!-- Footer -->
      <footer class="app-footer">
        <div class="cc-logo">
          <span>© <%= new Date().getFullYear() %></span>
          <a href="/">ZGQ Inc.</a>
        </div>
        <div style="opacity:0.8;">Serverless · No VPS · Pure Edge Computing</div>
        <div class="footer-links">
          <a href="/atom.xml" class="footer-link">
            <span class="native-icon">rss_feed</span> RSS
          </a>
          <a href="https://t.me/<%= config.telegram_channel || 'your_channel' %>" class="footer-link" target="_blank">
            <span class="native-icon">send</span> Telegram
          </a>
          <a href="https://hexo.io" class="footer-link" target="_blank">
            <span class="native-icon">code</span> Hexo
          </a>
        </div>
      </footer>
    </div>
  </div>

  <!-- Global Scripts -->
  <script>
    // Sidebar Toggle
    function toggleSidebar() {
      const drawer = document.getElementById('nav-drawer');
      const overlay = document.getElementById('sidebar-overlay');
      drawer.classList.toggle('open');
      overlay.classList.toggle('active');
    }

    // Theme Toggle
    const html = document.documentElement;
    const themeBtn = document.getElementById('theme-toggle-btn');
    
    function applyTheme(theme) {
      if (theme === 'dark') {
        html.setAttribute('data-theme', 'dark');
        themeBtn.innerHTML = '<md-icon>light_mode</md-icon>';
      } else {
        html.removeAttribute('data-theme');
        themeBtn.innerHTML = '<md-icon>dark_mode</md-icon>';
      }
      localStorage.setItem('zgq-theme', theme);
    }

    const savedTheme = localStorage.getItem('zgq-theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    applyTheme(savedTheme);

    themeBtn.addEventListener('click', () => {
      const isDark = html.getAttribute('data-theme') === 'dark';
      applyTheme(isDark ? 'light' : 'dark');
    });

    // Close sidebar when window resizes to desktop view
    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) {
        document.getElementById('nav-drawer').classList.remove('open');
        document.getElementById('sidebar-overlay').classList.remove('active');
      }
    });
  </script>

</body>
</html>
