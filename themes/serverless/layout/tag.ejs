<%
/* tag.ejs — Tag cloud page (or single tag listing) */
const isSingleTag = !!page.tag;
const allTags = site.tags.sort('name');
%>

<div class="fade-in-up container">

  <% if (isSingleTag) { %>
    <!-- ── Single Tag View ──────────────────────────────────────────────────── -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:32px;flex-wrap:wrap;">
      <md-text-button href="/tags/">
        <md-icon slot="icon">arrow_back</md-icon>所有标签
      </md-text-button>
      <div class="native-chip" style="font-size:1rem;height:auto;padding:8px 16px;background:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container);">
        <span class="native-icon" style="margin-right:4px;">label</span>
        <%= page.tag %>
      </div>
      <span style="opacity:0.5;font-size:0.9rem;"><%= page.posts.length %> 篇文章</span>
    </div>

    <div class="gallery-container grid-mode">
      <% page.posts.sort('date', -1).each(function(post, i) { %>
        <% 
           let catName = 'Default';
           if (post.categories && post.categories.length > 0) {
             catName = post.categories.data[0].name;
           }
        %>
        <div class="md-card">
          <a href="<%= url_for(post.path) %>" class="card-thumb-wrapper" style="background: linear-gradient(135deg, var(--md-sys-color-surface-variant), var(--md-sys-color-secondary-container));">
            <div class="badge-float badge-cat cat-<%= catName %>" onclick="window.location.href='<%= url_for(post.categories && post.categories.length > 0 ? post.categories.data[0].path : '/') %>'; return false;">
              <%= catName %>
            </div>
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); opacity:0.2;">
               <span class="native-icon" style="font-size: 64px;">article</span>
            </div>
          </a>
          
          <div class="card-content">
            <h3 class="card-title">
              <a href="<%= url_for(post.path) %>"><%= post.title %></a>
            </h3>
            <div class="card-subtitle">
              <%= post.excerpt ? strip_html(post.excerpt) : (post.content ? strip_html(post.content).slice(0, 100) + '…' : '') %>
            </div>
            
            <div class="meta-icons">
              <div class="meta-item">
                <span class="native-icon">calendar_today</span>
                <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  <% } else { %>
    <!-- ── Tag Cloud View ───────────────────────────────────────────────────── -->
    <div style="margin-bottom:40px;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
        <span class="native-icon" style="font-size:2rem;color:var(--md-sys-color-primary);">label</span>
        <h1 style="font-size:clamp(1.5rem,4vw,2.2rem);font-weight:700;margin:0;">标签云</h1>
      </div>
      <p style="opacity:0.6;margin:0;">共 <%= site.tags.length %> 个标签</p>
    </div>

    <!-- Tag chips — size proportional to post count -->
    <div class="post-wrapper" style="display:flex;flex-wrap:wrap;gap:12px;padding:24px;">
      <% allTags.each(function(tag) {
           const count = tag.posts.length;
           const maxCount = Math.max(...site.tags.map(t => t.posts.length));
           const scale = 0.75 + (count / maxCount) * 0.8;
           const opacity = 0.5 + (count / maxCount) * 0.5;
      %>
        <a href="<%= url_for(tag.path) %>" class="native-chip"
          style="font-size:<%= (0.75 + (count/maxCount)*0.45).toFixed(2) %>rem;opacity:<%= opacity.toFixed(2) %>;">
          <span class="native-icon" style="font-size:inherit;margin-right:4px;">label</span>
          <%= tag.name %>
          <span style="font-size:0.7em;opacity:0.7;margin-left:4px;">(<%= count %>)</span>
        </a>
      <% }) %>
    </div>

    <% if (site.tags.length === 0) { %>
      <div class="post-wrapper" style="padding:64px;text-align:center;opacity:0.6;">
        <p>暂无标签</p>
      </div>
    <% } %>
  <% } %>
</div>
