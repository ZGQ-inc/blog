<%
/* post.ejs — Article page */
%>

<div class="container fade-in-up">

  <!-- ── Breadcrumb ──────────────────────────────────────────────────────────── -->
  <nav style="display:flex;align-items:center;gap:8px;font-size:0.85rem;opacity:0.65;margin-bottom:24px;">
    <a href="/" style="color:inherit;text-decoration:none;">主页</a>
    <span class="native-icon" style="font-size:16px;">chevron_right</span>
    <% if (page.categories && page.categories.length > 0) { %>
      <% page.categories.each(function(cat) { %>
        <a href="<%= url_for(cat.path) %>" style="color:inherit;text-decoration:none;"><%= cat.name %></a>
        <span class="native-icon" style="font-size:16px;">chevron_right</span>
      <% }) %>
    <% } %>
    <span style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
      <%= page.title %>
    </span>
  </nav>

  <!-- ── Article Header ─────────────────────────────────────────────────────── -->
  <div class="post-wrapper">
    <header style="margin-bottom:24px;">
      <!-- Category + Tags chips -->
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
        <% if (page.categories && page.categories.length > 0) { %>
          <% page.categories.each(function(cat) { %>
            <a href="<%= url_for(cat.path) %>" class="native-chip">
              <span class="native-icon" style="font-size:14px;margin-right:4px;">folder</span>
              <%= cat.name %>
            </a>
          <% }) %>
        <% } %>
        <% if (page.tags && page.tags.length > 0) { %>
          <% page.tags.each(function(tag) { %>
            <a href="<%= url_for(tag.path) %>" class="native-chip" style="background-color:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container);">
              <span class="native-icon" style="font-size:14px;margin-right:4px;">label</span>
              <%= tag.name %>
            </a>
          <% }) %>
        <% } %>
      </div>

      <!-- Title -->
      <h1 style="font-size: clamp(1.5rem, 4vw, 2.5rem); margin: 0 0 16px; color: var(--md-sys-color-on-surface);"><%= page.title %></h1>

      <!-- Meta bar -->
      <div class="meta-icons" style="font-size:0.9rem;">
        <!-- Author avatar placeholder -->
        <div style="width:28px;height:28px;border-radius:50%;background:var(--md-sys-color-primary);color:var(--md-sys-color-on-primary);display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:bold;">
          <%= (page.author || config.author || 'Z').charAt(0).toUpperCase() %>
        </div>
        <span style="font-weight:500;margin-right:8px;"><%= page.author || config.author %></span>
        
        <div class="meta-item">
          <span class="native-icon">calendar_today</span>
          <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
        </div>
        <% if (page.updated && page.updated.valueOf() !== page.date.valueOf()) { %>
          <div class="meta-item" style="margin-left:8px;">
            <span class="native-icon">update</span>
            <time datetime="<%= date_xml(page.updated) %>">更新 <%= date(page.updated, 'MM-DD') %></time>
          </div>
        <% } %>
      </div>
    </header>

    <!-- ── Article Body ────────────────────────────────────────────────────────── -->
    <main class="post-body">
      <%- page.content %>
    </main>
  </div>

  <!-- ── Share & Navigation ─────────────────────────────────────────────────── -->
  <div style="display:flex;justify-content:space-between;margin-top:24px;gap:12px;flex-wrap:wrap;">
    <% if (page.prev) { %>
      <md-outlined-button href="<%= url_for(page.prev.path) %>" style="flex:1;">
        <md-icon slot="icon">arrow_back</md-icon>
        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">
          <%= page.prev.title %>
        </span>
      </md-outlined-button>
    <% } else { %><div style="flex:1;"></div><% } %>
    <% if (page.next) { %>
      <md-outlined-button href="<%= url_for(page.next.path) %>" trailing-icon style="flex:1;">
        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">
          <%= page.next.title %>
        </span>
        <md-icon slot="icon">arrow_forward</md-icon>
      </md-outlined-button>
    <% } else { %><div style="flex:1;"></div><% } %>
  </div>

  <!-- ═══ Comments Section ════════════════════════════════════════════════════ -->
  <div class="post-wrapper" style="margin-top: 24px;" id="comments">

    <h2 style="display:flex;align-items:center;gap:8px;font-size:1.3rem;margin:0 0 24px;">
      <span class="native-icon">comment</span>
      <span id="comment-count">评论</span>
      <!-- Telegram sync indicator -->
      <span class="live-dot" title="与 Telegram 群组实时同步" style="margin-left:8px;width:8px;height:8px;background:green;border-radius:50%;display:inline-block;"></span>
      <span style="font-size:0.8rem;font-weight:400;opacity:0.6;">Telegram 同步</span>
    </h2>

    <!-- Comment list -->
    <div id="comment-list"></div>

    <!-- Telegram discussion link -->
    <div style="margin:16px 0;" id="tg-discuss-link"></div>

    <!-- Comment form -->
    <div class="comments-section" id="comment-form-wrapper">
      <h3 style="font-size:1rem;font-weight:600;margin:0 0 16px;">发表评论</h3>

      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:16px;">
        <md-filled-text-field id="comment-name" label="昵称 *" required style="flex:1;min-width:200px;"></md-filled-text-field>
        <md-filled-text-field id="comment-email" label="邮箱 (可选)" type="email" style="flex:1;min-width:200px;"></md-filled-text-field>
        <md-filled-text-field id="comment-site" label="网站 (可选)" type="url" style="flex:1;min-width:200px;"></md-filled-text-field>
      </div>
      
      <md-filled-text-field
        id="comment-content"
        label="评论内容 *"
        required
        type="textarea"
        rows="4"
        style="width:100%;margin-bottom:16px;"
      ></md-filled-text-field>

      <div style="display:flex;justify-content:flex-end;">
        <md-filled-button id="comment-submit-btn" onclick="submitComment()">
          <md-icon slot="icon">send</md-icon>提交评论
        </md-filled-button>
      </div>
    </div>
  </div>
</div>

<script>
// ═══ Twikoo D1 Comment System ═══════════════════════════════════════════════
const POST_SLUG = '<%= page.path %>';
const WORKER_BASE = '/api'; // Cloudflare Worker endpoint (same-origin via Pages)

// ── Load Comments ────────────────────────────────────────────────────────────
async function loadComments() {
  try {
    const res = await fetch(WORKER_BASE + '/twikoo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ event: 'GET_COMMENTS', post_slug: POST_SLUG })
    });
    const { data } = await res.json();
    renderComments(data || []);
  } catch (err) {
    document.getElementById('comment-list').innerHTML =
      '<p style="opacity:0.5;text-align:center;">评论加载失败，请稍后再试。</p>';
  }
}

// ── Render Comments (Threaded) ───────────────────────────────────────────────
function renderComments(comments) {
  const countEl = document.getElementById('comment-count');
  countEl.textContent = `评论 (${comments.length})`;

  const list = document.getElementById('comment-list');
  if (!comments.length) {
    list.innerHTML = '<p style="opacity:0.5;text-align:center;padding:24px 0;">暂无评论，来抢沙发吧！</p>';
    return;
  }

  // Build parent → children map
  const rootComments = comments.filter(c => !c.parent_id);
  const childrenMap = {};
  comments.filter(c => c.parent_id).forEach(c => {
    (childrenMap[c.parent_id] = childrenMap[c.parent_id] || []).push(c);
  });

  function renderItem(comment, depth = 0) {
    const initials = (comment.author_name || '?').charAt(0).toUpperCase();
    const dateStr = new Date(comment.created_at * 1000).toLocaleDateString('zh-CN',
      { year:'numeric', month:'2-digit', day:'2-digit' });
    const isAdmin = comment.is_admin === 1;
    const children = childrenMap[comment.id] || [];

    return `
      <div class="forum-item" id="comment-${comment.id}"
           style="margin-left:${depth * 24}px; display:flex; gap:12px;">
        <div style="width:36px;height:36px;border-radius:50%;background:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container);display:flex;align-items:center;justify-content:center;font-weight:bold;flex-shrink:0;">${initials}</div>
        <div style="flex:1;min-width:0;">
          <div style="font-weight:500;font-size:0.95rem;">
            ${comment.author_website
              ? `<a href="${comment.author_website}" target="_blank" rel="noopener" style="color:var(--md-sys-color-primary);text-decoration:none;">${escHtml(comment.author_name)}</a>`
              : escHtml(comment.author_name)}
            ${isAdmin ? '<span class="native-chip" style="font-size:10px;padding:2px 4px;margin-left:4px;background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container);">博主</span>' : ''}
            <span style="font-size:0.8rem;color:var(--md-sys-color-outline);margin-left:8px;">${dateStr}</span>
          </div>
          <div style="margin-top:4px;font-size:0.95rem;line-height:1.5;">${comment.content}</div>
          <div style="margin-top:8px;">
            <md-text-button onclick="replyTo('${comment.id}', '${escHtml(comment.author_name)}')">
              <md-icon slot="icon">reply</md-icon>回复
            </md-text-button>
          </div>
        </div>
      </div>
      ${children.map(child => renderItem(child, depth + 1)).join('')}
    `;
  }

  list.innerHTML = rootComments.map(c => renderItem(c)).join('');
}

// ── Reply To ─────────────────────────────────────────────────────────────────
let replyingToId = null;
function replyTo(parentId, authorName) {
  replyingToId = parentId;
  const contentField = document.getElementById('comment-content');
  contentField.label = `回复 @${authorName}`;
  contentField.focus();
  document.getElementById('comment-form-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// ── Submit Comment ────────────────────────────────────────────────────────────
async function submitComment() {
  const btn = document.getElementById('comment-submit-btn');
  const name    = document.getElementById('comment-name').value.trim();
  const email   = document.getElementById('comment-email').value.trim();
  const site    = document.getElementById('comment-site').value.trim();
  const content = document.getElementById('comment-content').value.trim();

  if (!name || !content) {
    alert('请填写昵称和评论内容');
    return;
  }

  btn.disabled = true;

  try {
    const res = await fetch(WORKER_BASE + '/twikoo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event: 'COMMENT',
        post_slug: POST_SLUG,
        author_name: name,
        author_email: email || undefined,
        author_website: site || undefined,
        content,
        parent_id: replyingToId || undefined
      })
    });

    const result = await res.json();
    if (result.success) {
      alert('评论提交成功！');
      document.getElementById('comment-name').value = '';
      document.getElementById('comment-email').value = '';
      document.getElementById('comment-site').value = '';
      document.getElementById('comment-content').value = '';
      document.getElementById('comment-content').label = '评论内容 *';
      replyingToId = null;
      await loadComments();
    } else {
      alert(result.error || '提交失败，请重试');
    }
  } catch (err) {
    alert('网络错误，请稍后重试');
  } finally {
    btn.disabled = false;
  }
}

// ── Escape HTML ──────────────────────────────────────────────────────────────
function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Telegram Discuss Link ─────────────────────────────────────────────────────
const tgLinkEl = document.getElementById('tg-discuss-link');
if (tgLinkEl && '<%= config.telegram_channel || "" %>') {
  tgLinkEl.innerHTML = `
    <md-outlined-button href="https://t.me/<%= config.telegram_channel || '' %>" target="_blank">
      <md-icon slot="icon">send</md-icon>在 Telegram 中讨论
    </md-outlined-button>
  `;
}

// Init
loadComments();
</script>
