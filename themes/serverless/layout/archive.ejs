<%
/* archive.ejs — All posts archive, grouped by year */
const postsByYear = {};
site.posts.sort('date', -1).each(function(post) {
  const year = post.date.year();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
});
const years = Object.keys(postsByYear).sort((a, b) => b - a);
%>

<div class="fade-in-up">
  <!-- Page header -->
  <div style="margin-bottom:40px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
      <mdui-icon name="library_books--rounded" style="font-size:2rem;color:var(--md-sys-color-primary);"></mdui-icon>
      <h1 style="font-size:clamp(1.5rem,4vw,2.2rem);font-weight:700;margin:0;">文章归档</h1>
    </div>
    <p style="opacity:0.6;margin:0;">共 <%= site.posts.length %> 篇文章</p>
  </div>

  <!-- Year sections -->
  <% years.forEach(function(year) { %>
    <section class="archive-year fade-in-up">
      <h2 class="archive-year-title">
        <mdui-icon name="event--outlined" style="font-size:1.3rem;"></mdui-icon>
        <%= year %>
        <span style="font-size:0.9rem;font-weight:400;opacity:0.5;margin-left:8px;">
          <%= postsByYear[year].length %> 篇
        </span>
      </h2>

      <mdui-list>
        <% postsByYear[year].forEach(function(post) { %>
          <mdui-list-item
            href="<%= url_for(post.path) %>"
            rounded
            style="margin-bottom:4px;"
            icon="article--outlined">

            <!-- Title slot -->
            <span style="font-weight:500;"><%= post.title %></span>

            <!-- Date slot -->
            <span slot="description" style="font-size:0.8rem;opacity:0.6;">
              <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time>
              <% if (post.categories && post.categories.length > 0) { %>
                &nbsp;·&nbsp;
                <% post.categories.each(function(cat) { %>
                  <%= cat.name %>
                <% }) %>
              <% } %>
            </span>

            <!-- Tags in end slot -->
            <div slot="end-icon" style="display:flex;gap:4px;flex-wrap:wrap;max-width:200px;justify-content:flex-end;">
              <% if (post.tags && post.tags.length > 0) { %>
                <% post.tags.toArray().slice(0, 2).forEach(function(tag) { %>
                  <mdui-chip style="height:20px;font-size:0.72rem;"><%= tag.name %></mdui-chip>
                <% }) %>
              <% } %>
            </div>
          </mdui-list-item>
        <% }) %>
      </mdui-list>
    </section>
  <% }) %>

  <% if (years.length === 0) { %>
    <div class="liquid-glass-card" style="padding:64px;text-align:center;opacity:0.6;">
      <mdui-icon name="inbox--outlined" style="font-size:3rem;display:block;margin-bottom:16px;"></mdui-icon>
      <p>暂无归档文章</p>
    </div>
  <% } %>
</div>
